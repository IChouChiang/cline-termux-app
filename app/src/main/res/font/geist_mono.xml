<?xml version="1.0" encoding="utf-8"?>
<!-- Geist Mono (Vercel, SIL OFL 1.1; license in assets/licenses/GeistMono-OFL.txt).
     Static instances from the geist-font v1.7.2 release (font version 1.700):
     Regular (400) and Medium (500). Design system section 2.2 (ClineMono). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/geist_mono_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/geist_mono_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/geist_mono_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/geist_mono_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
</font-family>
