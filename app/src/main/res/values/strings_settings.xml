    <string name="settings_cd_pair">%1$s, %2$s</string>
    <string name="settings_saving">Saving</string>
    <!-- (Android) Switch state spoken with a transient state such as "Saving": "On, Saving". -->
    <string name="settings_switch_on">On</string>
