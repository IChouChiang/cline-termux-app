<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Settings home and Appearance (design/screens/settings-providers.md S1, S2), owned by the
      settings-core package. Prefixes: settings_ (S1), appearance_ (S2). The Notifications page
      (S3) uses the notif_settings_* strings of strings_notifications.xml.
      Desktop copy is verbatim; strings marked (Android) in the spec are new.
    -->

    <!-- S1 page -->
    <string name="settings_title">Settings</string>
