<?xml version="1.0" encoding="utf-8"?>
<!--
  Chat screen (work package chat-screen): home-chat.md §2 Home, §6 conversation header,
  §2.5 branch sheet, §6.6 export, §6.7 rename/delete; keys per HC §8. Desktop copy verbatim;
  (Android) marks new strings. Reused from other files (do not redefine): chat_* thread copy
  (strings_thread.xml), chat_transport_* (strings_transcript.xml), components_kernel_*,
  components_open_sessions, components_copied (strings_components.xml), state_kernel_status
  (strings_kernel.xml), sessions_delete_* / sessions_pin_failed / sessions_unpin_failed /
  session_details_* (strings_sessions.xml), fork_failed (strings_queue_suggestions.xml),
  checkpoint_header_menu (strings_checkpoints.xml).
-->
<resources>
    <!-- Home workspace and branch chips (HC §2.4) -->
    <!-- (Android, decided A22) no folder chosen: the session starts in the Termux home -->
    <string name="home_workspace_default">Home</string>
    <string name="home_workspace_home">~</string>
    <string name="home_workspace_cd">Workspace: %1$s</string>
    <string name="home_branch_cd">Branch: %1$s</string>
